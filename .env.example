# Run npm run setup to create .env and private keys.
# Portable single/multi-user hosting: see docs/hosting.md and npm run host.
# Keep this mode only for the private exe.dev authenticated proxy.
WATERLOO_AUTH_MODE=exedev
WATERLOO_ORIGIN=https://YOUR-VM.exe.xyz
WATERLOO_OWNER_EMAIL=your-exe-account@example.com
D2L_USERNAME=youruserid@uwaterloo.ca
# Explicit opt-in: automatic renewal can select "this is my device" in Duo.
WATERLOO_REMEMBER_DEVICE=false
